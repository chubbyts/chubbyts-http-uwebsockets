{
  "name": "@chubbyts/chubbyts-http-uwebsockets",
  "type": "module",
  "version": "1.2.1",
  "description": "Use @chubbyts/chubbyts-http-types on uwebsockets.",
  "keywords": [
    "chubbyts",
    "http",
    "uwebsockets",
    "server-request",
    "response",
    "bridge"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-http-uwebsockets",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src tests vitest.config.ts vitest.integration.config.ts vitest.integration.setup.ts",
    "lint": "oxlint src tests vitest.config.ts vitest.integration.config.ts vitest.integration.setup.ts",
    "prepare": "pnpm run build",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-http-types": "^4.3.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-function-mock": "^2.4.1",
    "@chubbyts/chubbyts-http": "^3.2.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-fetch": "^4.1.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
